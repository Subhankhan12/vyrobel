# ══════════════════════════════════════════════════════════════════════════════════════════════════
#  Vyrobel — dev/CI PARITY IMAGE
#
#  ⚠️⚠️ THIS IS NOT A PRODUCTION IMAGE, AND MUST NEVER BE DEPLOYED.
#  Vyrobel deploys by server PULL-IN-PLACE with maintenance mode (docs/DEPLOYMENT.md §7.3) — there is no
#  container in the production path. This image exists so that CI and a developer's laptop can run against
#  the SAME runtime the production host is contracted to provide (§7.5), instead of whatever happens to be
#  installed on the machine that ran the tests.
#
#  ⚠️ IT CARRIES NO APPLICATION CODE, NO .env, AND NO SECRETS. CI checks the repo out and mounts it.
#
#  ⚠️⚠️ THE CONTRACT IS ops/runtime-contract.sh, NOT THIS FILE. This Dockerfile installs things; the script
#  ASSERTS them, and CI runs it as its first gate. If this image ever drifts from §7.5, the script reds the
#  build — which is the whole reason the image lands in §7.6 (consumed) rather than §7.5 (described).
#  A Dockerfile nothing runs is free to drift; one CI runs on every push is pinned to reality.
# ══════════════════════════════════════════════════════════════════════════════════════════════════

# §7.5.2 — the floor is composer.json's "php": "^8.4.1". Pinned to a patch release so a CI run is
# reproducible; bump deliberately, never implicitly.
FROM php:8.4.13-cli-bookworm

LABEL org.opencontainers.image.title="vyrobel-ci" \
      org.opencontainers.image.description="dev/CI parity runtime for Vyrobel — NOT a production image" \
      org.opencontainers.image.source="https://github.com/Subhankhan12/vyrobel" \
      com.vyrobel.contract="docs/DEPLOYMENT.md §7.5 · asserted by ops/runtime-contract.sh" \
      com.vyrobel.production="false"

# ── System libraries the PHP extensions below compile against ──────────────────────────────────────
#  libzip     → ext-zip        (§7.5.2: OwnerArchiveZipController + openspout)
#  libxml2    → the openspout XML set (dom/filter/libxml/xmlreader)
#  libsodium  → ext-sodium     (Passport's JWT libraries)
#  libpng/jpeg/freetype → ext-gd — ⚠️ CI-ONLY, see the gd block below
#  default-mysql-client + git/unzip → tooling for the workflow itself
RUN apt-get update && apt-get install -y --no-install-recommends \
        git unzip ca-certificates \
        libzip-dev libxml2-dev libsodium-dev \
        libpng-dev libjpeg62-turbo-dev libfreetype6-dev \
        libicu-dev \
        default-mysql-client \
    && rm -rf /var/lib/apt/lists/*

# ── The §7.5.2 extension set ───────────────────────────────────────────────────────────────────────
# Already compiled into the official image and NOT repeated here: mbstring · json · openssl · curl ·
# fileinfo · filter · libxml · dom · xmlreader · iconv · hash · pcre · session · ctype · posix.
# The contract script verifies every one of them regardless of who provided it.
#
#  pdo_mysql → every query (MySQL 8, §7.5.3)
#  zip       → ZipArchive in OwnerArchiveZipController
#  sodium    → OAuth token signing via firebase/php-jwt + lcobucci/jwt
#  ⚠️ pcntl  → Horizon forks its workers. §7.5.1(c): the FUNCTIONS must also be callable, which the
#              contract script checks — this image sets no disable_functions, so they are.
RUN docker-php-ext-install -j"$(nproc)" pdo_mysql zip sodium pcntl

# ── ⚠️ §7.5.1(a) — ext-redis, the trap `composer check-platform-reqs` CANNOT SEE ────────────────────
# config/database.php:148 defaults REDIS_CLIENT to `phpredis`, which is this C extension — and it is NOT
# declared in composer.json, so nothing in the normal pre-flight would notice its absence. Installing it
# here means the image satisfies the contract under EITHER client setting, exactly as §7.5.1(a) asks.
RUN pecl install redis && docker-php-ext-enable redis

# ── ⚠️⚠️ ext-gd — CI-ONLY, AND DELIBERATELY BEYOND THE §7.5 CONTRACT ────────────────────────────────
# §7.5.2 correctly EXCLUDES gd from production: its only caller is App\Support\Media\PlaceholderImage,
# reached solely by DemoSeeder and one test, and production is never seeded (§4).
# ⚠️ But "one test" is tests/Feature/RoomPhotosTest.php:79, which calls PlaceholderImage::jpeg() and
# THROWS without gd — so the TEST SUITE needs what production does not. This is a documented, intentional
# CI-only addition (§7.6.4), not image drift. The contract script prints it under a separate CI-ONLY
# heading so the two sets never blur together.
RUN docker-php-ext-configure gd --with-freetype --with-jpeg \
    && docker-php-ext-install -j"$(nproc)" gd

# ── ext-intl (§7.5.1b) — INSTALLED since 2026-11-05, because the app now REQUIRES it ──────────────────────
# It was left out on purpose while the app only made one guarded \Locale::getDisplayRegion() call, so CI would catch any
# unguarded use. I18N-01 (27 languages) uses it everywhere — dates (IntlDatePatternGenerator), language names (\Locale) — and
# the production host provides it. The contract (ops/runtime-contract.sh) now ASSERTS it, so the image and production stay equal.
# (The first CI run of the 27-language code, 2026-11-05, failed 23 tests with `Class "Locale" not found` before this.)
RUN docker-php-ext-install -j"$(nproc)" intl

# ── ⚠️ The php.ini contract (§7.5.4), derived from real upload ceilings and the ID-encryption path ──
# Without these the image would run at PHP's 2M/8M/128M defaults — which is exactly what a developer
# laptop does today, and why an 8 MB ID upload cannot be exercised there at all.
RUN { \
      echo 'upload_max_filesize=12M'; \
      echo 'post_max_size=14M'; \
      echo 'memory_limit=512M'; \
      echo 'opcache.enable=1'; \
      echo 'opcache.enable_cli=0'; \
    } > /usr/local/etc/php/conf.d/zz-vyrobel-contract.ini
# memory_limit is 512M, not the contract's 256M floor: phpunit.xml:27 raises the SUITE to 512M (dompdf
# embeds a full DejaVu font per PDF test). The floor is a minimum — exceeding it is compliant.

# ── Composer (pinned major) ────────────────────────────────────────────────────────────────────────
COPY --from=composer:2 /usr/bin/composer /usr/bin/composer

# ── Node — BUILD-ONLY (§7.5.3: not needed at runtime, but `npm run build` runs in CI as it does in §7.3)
RUN curl -fsSL https://deb.nodesource.com/setup_22.x | bash - \
    && apt-get install -y --no-install-recommends nodejs \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# ⚠️ No CMD that runs the app. This image is a runtime, not a service.
CMD ["php", "-v"]
