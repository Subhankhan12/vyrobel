# ═══════════════════════════════════════════════════════════════════════════════════════════════════
# ⚠️⚠️ THIS IS A **RECORD**, NOT AN ENFORCEMENT. NOTHING DEPLOYS THIS FILE.
# ═══════════════════════════════════════════════════════════════════════════════════════════════════
#
# ⚠️ WHAT THIS IS. A verbatim copy of the LIVE `public_html/.htaccess` on the production host
# (Hostinger shared, `~/domains/vyrobel.com/public_html/.htaccess`), recorded here on 2026-09-21.
#
# ⚠️⚠️ WHY IT EXISTS. That file is the only thing standing between the public internet and `.env`,
# `artisan` and `storage/` — because the document root IS the application root (see KNOWN-LIMITS L12p).
# Until this copy was made it existed in exactly ONE place, with its only backup
# (`~/htaccess-backups/`) sitting **on the same disk as the file it protects**. ⚠️ That is not a backup,
# it is a second copy of the same risk — the identical mistake this project already made with the git
# bundle before the push. This repository is pushed, so this is the first copy of this file that has
# ever existed OFF the host.
#
# ⚠️⚠️ IT IS NOT LIVE AND EDITING IT CHANGES NOTHING. `public_html` is a real directory the hosting
# panel owns; `ops/deploy.sh` never writes there, and a deploy moves only the `current` symlink. So:
#   · Editing this file does NOT change production.
#   · Deploying does NOT restore production from this file.
#   · Restoring is a MANUAL step: copy everything below the BEGIN marker to
#     `~/domains/vyrobel.com/public_html/.htaccess`, then re-run `ops/exposure-battery.sh`.
# ⚠️ A file in a repository that LOOKS deployed and is not is worse than no file at all, because the
# next person assumes it is live. It is not. This block is why you know that.
#
# ⚠️ TWO LEVELS OF DEFENCE, AND THEY CATCH DIFFERENT THINGS:
#   · `ops/htaccess-drift-check.sh` catches a CHANGE  — the rules stopped being present.
#   · `ops/exposure-battery.sh`     catches an EFFECT — something became reachable.
# ⚠️ A rule can be edited without anything becoming reachable, and something can become reachable
# without this file changing (a panel change, a server that stops honouring AllowOverride). Neither
# check subsumes the other — the same reason the alarm carries two independent detectors.
#
#
# ⚠️⚠️ UPDATED 2026-09-23 (PUBLIC 01) — THE SITE IS PUBLIC AND THE LOCK IS OFF.
# Both privacy layers came off in one pass: maintenance first, the lock second. ⚠️ That order is not a
# preference — lock-first would have made the site public while it was still serving a maintenance page.
#
# ───────── THE LOCK, KEPT VERBATIM AND COMMENTED SO IT GOES BACK ON IN ONE EDIT ─────────
# ⚠️⚠️ BEFORE RE-ADDING THIS, PUT A USER IN `~/domains/vyrobel.com/.htpasswd` — it still exists and is
#    still EMPTY, so pasting these lines back locks the site against EVERYONE including the founder.
#    `~/domains/vyrobel.com/vyrobel-lock.php` prompts for a password and proves the result from outside.
# ⚠️ Every exemption is $-anchored on purpose: a bare `^/up` would also exempt /upgrade and /uptime.
#
#   SetEnvIf Request_URI "^(/current/public)?/webhooks/stripe(/connect)?/?$" VY_PUBLIC=1
#   SetEnvIf Request_URI "^(/current/public)?/webhooks/channex/[A-Za-z0-9._-]+/?$" VY_PUBLIC=1
#   SetEnvIf Request_URI "^(/current/public)?/up(/liveness)?/?$" VY_PUBLIC=1
#   AuthType Basic
#   AuthName "Vyrobel - private preview"
#   AuthUserFile /home/u545270279/domains/vyrobel.com/.htpasswd
#   <RequireAny>
#       Require env VY_PUBLIC
#       Require env REDIRECT_VY_PUBLIC
#       Require valid-user
#   </RequireAny>
#
# 🔬 Recorded sha256 of the canonical content below: d5b4b6ee92d9efa503a45f51c76a098113fb1fa61c9062d8de9478ce13484d39
#
# ───────── BEGIN CANONICAL CONTENT — restore from the NEXT line down ─────────
# ── Vyrobel — serve the CURRENT release through ONE pointer ────────────────────
# ⚠️ `public_html` stays a real directory the hosting panel owns. A deploy moves only the
#    `current` symlink below it: ONE atomic rename, with nothing beside it that must also move.
# ⚠️⚠️ FollowSymLinks is REQUIRED — a symlink INSIDE the served tree is not traversed without
#    it, which is why the first attempt 404'd every application route.
Options +FollowSymLinks -Indexes

RewriteEngine On

RewriteCond %{THE_REQUEST} \s/current/public/(\S*)\sHTTP
RewriteRule ^ /%1 [R=301,L]

# ⚠️⚠️ The front controller AND every build asset resolve THROUGH `current`, so a release
#    swap is one operation and assets can never lag a release behind the code.
# ⚠️ The site root goes STRAIGHT to the front controller. Rewriting it to a DIRECTORY lets
#    Laravel's own "redirect trailing slashes" rule fire on /current/public/ and emit a 301 — which a
#    CDN then caches. 🔬 Measured 2026-09-20: that 301 was replayed for ~30 minutes after the origin was
#    correct again. One explicit rule removes the interaction entirely.
RewriteRule ^$ /current/public/index.php [L]

RewriteCond %{REQUEST_URI} !^/current/public
RewriteRule ^(.*)$ /current/public/$1 [L]

<FilesMatch "^\.">
    Require all denied
</FilesMatch>
RedirectMatch 404 ^/(bootstrap|config|database|resources|routes|storage|vendor|ops)(/|$)
RedirectMatch 404 ^/current/(app|bootstrap|config|database|resources|routes|storage|vendor|ops)(/|$)
RedirectMatch 404 ^/current/(composer\.(json|lock)|package\.json|artisan|vite\.config\.js)$
RedirectMatch 404 ^/(composer\.(json|lock)|package\.json|artisan|vite\.config\.js)$

# ── ⚠️ THE PRIVATE-PREVIEW LOCK WAS REMOVED HERE ON 2026-09-23 (PUBLIC 01) ──────────────────────────
# ⚠️⚠️ FOUNDER'S RULING: `vyrobel.com` IS PUBLIC. Both privacy layers came off in one pass, maintenance
#    first and the lock second — ⚠️ that order is not a preference: taking the lock off first would have
#    made the site public **while it was still serving a maintenance page**, which is the worst of both.
#
# ⚠️ THE RULES ARE NOT LOST. They are kept verbatim, commented, in `ops/reference/public_html.htaccess`,
#    so the lock goes back on in one edit. ⚠️ `~/domains/vyrobel.com/.htpasswd` still exists and is still
#    EMPTY — ⚠️⚠️ re-adding `AuthType Basic` without first putting a user in it locks the site against
#    EVERYONE, including the founder. Put the user in first: `vyrobel-lock.php` beside it does that.
#
# ⚠️ `ops/htaccess-drift-check.sh` no longer REQUIRES the lock, but it still knows about it: if AuthType
#    Basic ever reappears, the check demands AuthUserFile and Require valid-user alongside it, and still
#    refuses an unanchored exemption. ⚠️ **A half-built lock is worse than none** — it either 500s every
#    request or lets everything through, and both look like a working rule from the outside.
