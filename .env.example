APP_NAME=Vyrobel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
# ⚠️ `daily` in production, not `single` (audit F6-11): `single` writes one laravel.log that grows
# without bound and has no rotation to notice. `daily` keeps LOG_DAILY_DAYS files (default 14).
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_DAILY_DAYS=14
# `debug` logs every query and payload — far too verbose (and too revealing) for production.
# The config default is already environment-aware; this makes it explicit for a deploy.
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=vyrobel
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail — the ENV MATRIX (Phase 8 · production email). STRICTLY separated by environment:
#   • local / dev  → MAIL_MAILER=log (zero deps, emails go to storage/logs) OR =smtp for Mailpit
#                    (`brew install mailpit`, run `mailpit`; SMTP 127.0.0.1:1025, UI :8025 — a LOCAL
#                    catch, never delivered to real people).
#   • test / CI    → array (set in phpunit.xml — NEVER sends; the suite can't email a real person).
#   • production   → MAIL_MAILER=postmark (the real transactional provider). Postmark's server API
#                    TOKEN goes in ENV ONLY (below) — never committed.
# THE #1 GUARD (MailSafetyGuard): a real-sending transport (postmark/ses/…) is REFUSED outside
# `production` and downgraded to `log`, so even MAIL_MAILER=postmark here can't email a real person
# unless APP_ENV=production. See docs/EMAIL-PRODUCTION.md for the DNS records Subhan must add.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
# The real sending identity (production). Must be an address on the DKIM-verified sending domain.
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Postmark (PRODUCTION transactional email) — set these ONLY in the production environment. The token is
# the Postmark "Server API token" from the server's API Tokens tab. Message stream is usually 'outbound'.
POSTMARK_TOKEN=
POSTMARK_MESSAGE_STREAM_ID=outbound

# ⚠️ THE PUBLIC CONTACT FORM'S DESTINATION (front-website Gate 7) — the mailbox that is TOLD when somebody
# writes in from /contact. ⚠️ DELIBERATELY BLANK, and blank is a supported state: the message itself is
# stored in `marketing_contact_messages` before any mail is attempted, so an unset address costs the
# notification and never the message. Set it to a real inbox you actually read before launch — it is not a
# secret, but it is yours, so no placeholder address is shipped here.
MARKETING_CONTACT_TO=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Phase 2: Channex channel manager. CHANNEX_FAKE=true keeps the app on FakeChannexClient
# (no network) until real staging credentials exist — flip to false + set CHANNEX_API_KEY
# for the live checkpoint only.
CHANNEX_BASE_URL=https://staging.channex.io/api/v1
CHANNEX_API_KEY=
CHANNEX_FAKE=true
CHANNEX_WEBHOOK_SECRET=

# Stripe (Phase 8 — live Stripe, TEST-MODE FIRST). PAYMENTS_GATEWAY=manual|stripe · PAYOUTS_RAIL=manual|stripe_connect.
# STRIPE_FAKE=true keeps the app on the in-memory FakeStripeClient (no network — CI pins this true).
# ⚠️ SAFETY (StripeSafetyGuard): a LIVE key (sk_live_…) is REFUSED outside APP_ENV=production — the fake client
# is bound instead, so a dev/CI run can never charge a real card. Use TEST-mode keys (sk_test_…) for the manual
# live-test checkpoint. THE LIVE-KEY FLIP IS SUBHAN'S FINAL GO-LIVE STEP (prod ENV only) — see docs/DECISIONS.md.
# Keys live in ENV ONLY (never committed). Two DISTINCT webhook endpoints, each with its own signing secret:
# /webhooks/stripe (account: payments + subscriptions) and /webhooks/stripe/connect (owner payouts).
PAYMENTS_GATEWAY=manual
PAYOUTS_RAIL=manual
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_WEBHOOK_SECRET=
STRIPE_FAKE=true
# Subscription-billing Stripe Price ids (test-mode → live; from the Stripe dashboard). Null → a fake placeholder
# so the app flows end-to-end on the fake client. See docs/STRIPE-PRODUCTION.md.
STRIPE_PRICE_ESSENTIAL_MONTHLY=
STRIPE_PRICE_ESSENTIAL_YEARLY=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=

# ⚠️ BACKUP_PASSPHRASE IS DELIBERATELY NOT LISTED HERE — and must not be added.
# It is an INVOCATION-TIME secret: ops/deploy.sh reads ${BACKUP_PASSPHRASE:-} from the SHELL environment and
# ops/backup.sh passes it to `openssl enc -pass env:BACKUP_PASSPHRASE`, so it never rests in a file on the
# server.  Run:  BACKUP_PASSPHRASE='…' ops/deploy.sh
# ⚠️ Losing it makes every encrypted backup permanently unreadable. Custody: docs/DEPLOYMENT.md §7.4.4.

VITE_APP_NAME="${APP_NAME}"

# ── Security / proxy hardening (audit 2026-08-08) ───────────────────────────────────────────────
# ⚠️ (2026-10-06) The next two stay COMMENTED OUT: an EMPTY line is a value ('') and turns the production
# default OFF — a deploy copied from this file got non-secure session cookies and plain-http URLs (GitHub's
# checks, built from this file, read both as off). Uncomment one only to override its default.
# Session cookie Secure flag. Defaults to TRUE when APP_ENV=production and false otherwise, so local
# http dev works untouched. Set explicitly only to override that.
# SESSION_SECURE_COOKIE=true
# Force https:// in every generated URL (form actions, redirects, signed reset/verify links, email
# assets). Defaults to on in production. Set false only if TLS genuinely terminates at the app.
# FORCE_HTTPS=true
# Trusted reverse proxies / load balancers. UNSET = trust none (safe: a spoofed X-Forwarded-For is
# ignored). ⚠️ Behind a LB you MUST set this or three controls break silently: the operator IP
# allowlist compares the proxy's address, per-IP rate limiting collapses into one bucket, and
# isSecure() reads false (suppressing HSTS and the secure cookie). Use '*' when the app is only
# reachable through the LB, or a comma-separated list of proxy addresses.
TRUSTED_PROXIES=

# ── Vyrobel app-specific settings (audit F6-5 — these were entirely undocumented) ────────────────
# ⚠️ The framework's own knobs (beanstalkd/dynamodb/memcached/sqs/papertrail…) are deliberately NOT
# listed here — they are Laravel defaults nobody needs to set. What follows is everything specific
# to THIS application, so a deploy can be configured without reading the source.

# PAYOUT ENGINE — the founder's go-live flip. Inert while false: the scheduled `payouts:run` command
# is a no-op, so no owner is ever paid automatically. Set true ONLY together with live Stripe keys +
# Connect KYC (docs/STRIPE-PRODUCTION.md §3b).
PAYOUT_ENGINE_ENABLED=false

# PUBLIC BOOKING ENGINE — per-IP requests/minute on the unauthenticated storefront search/quote/book.
BOOKING_RATE_LIMIT=60

# AUTH THROTTLE — per-IP login attempts/minute across all four realms (the per-credential limit lives
# in the FormRequests and is separate). Raise only if a large office shares one NAT address.
LOGIN_IP_RATE_LIMIT=20

# AI / LLM — honestly deferred. LLM_FAKE=true binds FakeLlmClient, so nothing is ever sent to a
# provider and no key is required. Flipping it needs a real key AND a cost cap you are happy with.
LLM_FAKE=true
LLM_PROVIDER=anthropic
LLM_MODEL=
LLM_MAX_OUTPUT_TOKENS=1024
LLM_DAILY_TOKEN_CAP=200000
ANTHROPIC_API_KEY=

# UNIFIED INBOX CHANNELS — account-gated. Each stays false until its provider account exists; a
# deferred channel fails VISIBLY rather than faking a delivery (#39).
INBOX_EMAIL_ENABLED=false
INBOX_WHATSAPP_ENABLED=false
INBOX_BOOKING_COM_ENABLED=false
INBOX_AIRBNB_ENABLED=false

# OAUTH (Passport) — the owner-scoped API. Keys are generated per environment with
# `php artisan passport:keys` and are NEVER committed (see .gitignore). Set these two only if you
# inject the keys via env instead of the filesystem.
PASSPORT_PRIVATE_KEY=
PASSPORT_PUBLIC_KEY=

# HORIZON — the queue dashboard is Super-Admin gated. Override only for a custom path/domain.
HORIZON_PATH=horizon

# ── Google sign-in (OAuth 2.0) ────────────────────────────────────────────────────────────────────────
# ⚠️ FOUNDER-ENTERED, NEVER COMMITTED — the same class as the Stripe keys. Get them from the Google Cloud
#    console; the exact fields, scopes and redirect URIs are in docs/GOOGLE-SIGN-IN.md.
# ⚠️ EMPTY IS THE SHIPPING STATE AND IS SAFE: with these blank, "Continue with Google" is not rendered and
#    both /auth/google routes return 404. There is no separate on/off flag to fall out of step with them.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional. Defaults to <APP_URL>/auth/google/callback — set it only if that is not the registered URI.
GOOGLE_REDIRECT_URI=
