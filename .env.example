APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=vyrobel
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail — the ENV MATRIX (Phase 8 · production email). STRICTLY separated by environment:
#   • local / dev  → MAIL_MAILER=log (zero deps, emails go to storage/logs) OR =smtp for Mailpit
#                    (`brew install mailpit`, run `mailpit`; SMTP 127.0.0.1:1025, UI :8025 — a LOCAL
#                    catch, never delivered to real people).
#   • test / CI    → array (set in phpunit.xml — NEVER sends; the suite can't email a real person).
#   • production   → MAIL_MAILER=postmark (the real transactional provider). Postmark's server API
#                    TOKEN goes in ENV ONLY (below) — never committed.
# THE #1 GUARD (MailSafetyGuard): a real-sending transport (postmark/ses/…) is REFUSED outside
# `production` and downgraded to `log`, so even MAIL_MAILER=postmark here can't email a real person
# unless APP_ENV=production. See docs/EMAIL-PRODUCTION.md for the DNS records Subhan must add.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
# The real sending identity (production). Must be an address on the DKIM-verified sending domain.
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Postmark (PRODUCTION transactional email) — set these ONLY in the production environment. The token is
# the Postmark "Server API token" from the server's API Tokens tab. Message stream is usually 'outbound'.
POSTMARK_TOKEN=
POSTMARK_MESSAGE_STREAM_ID=outbound

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Phase 2: Channex channel manager. CHANNEX_FAKE=true keeps the app on FakeChannexClient
# (no network) until real staging credentials exist — flip to false + set CHANNEX_API_KEY
# for the live checkpoint only.
CHANNEX_BASE_URL=https://staging.channex.io/api/v1
CHANNEX_API_KEY=
CHANNEX_FAKE=true
CHANNEX_WEBHOOK_SECRET=

# Stripe (Phase 8 — live Stripe, TEST-MODE FIRST). PAYMENTS_GATEWAY=manual|stripe · PAYOUTS_RAIL=manual|stripe_connect.
# STRIPE_FAKE=true keeps the app on the in-memory FakeStripeClient (no network — CI pins this true).
# ⚠️ SAFETY (StripeSafetyGuard): a LIVE key (sk_live_…) is REFUSED outside APP_ENV=production — the fake client
# is bound instead, so a dev/CI run can never charge a real card. Use TEST-mode keys (sk_test_…) for the manual
# live-test checkpoint. THE LIVE-KEY FLIP IS SUBHAN'S FINAL GO-LIVE STEP (prod ENV only) — see docs/DECISIONS.md.
# Keys live in ENV ONLY (never committed). Two DISTINCT webhook endpoints, each with its own signing secret:
# /webhooks/stripe (account: payments + subscriptions) and /webhooks/stripe/connect (owner payouts).
PAYMENTS_GATEWAY=manual
PAYOUTS_RAIL=manual
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_WEBHOOK_SECRET=
STRIPE_FAKE=true
# Subscription-billing Stripe Price ids (test-mode → live; from the Stripe dashboard). Null → a fake placeholder
# so the app flows end-to-end on the fake client. See docs/STRIPE-PRODUCTION.md.
STRIPE_PRICE_ESSENTIAL_MONTHLY=
STRIPE_PRICE_ESSENTIAL_YEARLY=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=

VITE_APP_NAME="${APP_NAME}"

# ── Security / proxy hardening (audit 2026-08-08) ───────────────────────────────────────────────
# Session cookie Secure flag. Defaults to TRUE when APP_ENV=production and false otherwise, so local
# http dev works untouched. Set explicitly only to override that.
SESSION_SECURE_COOKIE=
# Force https:// in every generated URL (form actions, redirects, signed reset/verify links, email
# assets). Defaults to on in production. Set false only if TLS genuinely terminates at the app.
FORCE_HTTPS=
# Trusted reverse proxies / load balancers. UNSET = trust none (safe: a spoofed X-Forwarded-For is
# ignored). ⚠️ Behind a LB you MUST set this or three controls break silently: the operator IP
# allowlist compares the proxy's address, per-IP rate limiting collapses into one bucket, and
# isSecure() reads false (suppressing HSTS and the secure cookie). Use '*' when the app is only
# reachable through the LB, or a comma-separated list of proxy addresses.
TRUSTED_PROXIES=
