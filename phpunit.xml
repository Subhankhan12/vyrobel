<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <!-- The suite outgrew PHP's 128M CLI default: dompdf embeds a full DejaVu font per PDF export
             test, and every operator test now provisions its org's 13-role x 44-permission catalog for
             the /app back-office gate. Verified as headroom, NOT a leak (the whole suite passes under a
             raised limit; nothing grows unboundedly). Set here so the documented `php artisan test`
             works — it spawns a child PHP that re-reads php.ini, so a `-d memory_limit` on the parent
             does not reach it. -->
        <ini name="memory_limit" value="512M"/>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <!-- Genuine MySQL for tests: the no-double-booking guarantee lives in InnoDB row
             locking (SELECT … FOR UPDATE) and cannot be exercised on sqlite. -->
        <env name="DB_CONNECTION" value="mysql"/>
        <env name="DB_DATABASE" value="vyrobel_test"/>
        <env name="DB_HOST" value="127.0.0.1"/>
        <env name="DB_PORT" value="3306"/>
        <env name="DB_USERNAME" value="root"/>
        <env name="DB_PASSWORD" value=""/>
        <env name="DB_URL" value=""/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <!-- Never hit the real Channex network in tests — always the in-memory fake. -->
        <env name="CHANNEX_FAKE" value="true"/>
        <!-- Deterministic secret so webhook-signature tests can sign simulated payloads. -->
        <env name="CHANNEX_WEBHOOK_SECRET" value="test-webhook-secret"/>
        <!-- Never hit the real Stripe network in tests — always the in-memory fake. -->
        <env name="STRIPE_FAKE" value="true"/>
        <!-- CI default gateway is Manual regardless of .env (which may be flipped to stripe during a
             live-integration checkpoint). Stripe tests opt in per-test via config(). -->
        <env name="PAYMENTS_GATEWAY" value="manual"/>
        <env name="STRIPE_WEBHOOK_SECRET" value="whsec_test_stripe_secret"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
